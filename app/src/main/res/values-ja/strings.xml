    <!-- App Info Screen -->
    <string name="app_intro_title">アプリ紹介</string>
    <string name="app_intro_subtitle">外国人労働者の契約理解と権利保護のためのAI契約書分析アプリ</string>
    <string name="app_intro_description">韓国で働く外国人労働者の多くが契約書を作成しないか、作成しても内容を理解できずに賃金未払い、不当解雇、長時間労働などの深刻な権利侵害を受けています。\n\nLawRoはAIを活用して労働契約書を自動分析し、外国人労働者が自分の契約内容を母国語で理解し、違反事項を認識して自ら権利を守ることができるよう支援するアプリです。</string>
    <string name="main_features">主要機能</string>
    <string name="feature_contract_analysis">契約書自動分析</string>
    <string name="feature_contract_analysis_desc">OCRで労働契約書を認識し、必須項目の欠落の有無および法律違反の可能性を確認</string>
    <string name="feature_multilingual_support">母国語法律解釈提供</string>
    <string name="feature_multilingual_support_desc">契約内容をユーザーの母国語で簡単に理解できるよう翻訳および説明</string>
    <string name="feature_contract_history">契約履歴管理</string>
    <string name="feature_contract_history_desc">締結された契約書をデジタルで保存、紛争や契約更新時に活用可能</string>
    <string name="feature_chatbot_consultation">労働/法律チャットボット相談</string>
    <string name="feature_chatbot_consultation_desc">労働条件・法律違反など気になる点をリアルタイムで相談</string>
    <string name="feature_worktime_tracking">勤務時間記録および給与計算</string>
    <string name="feature_worktime_tracking_desc">労働時間を自動的に記録し、超過勤務手当など正確な給与計算支援</string>
    <string name="feature_multilingual_ui">多言語対応UI</string>
    <string name="feature_multilingual_ui_desc">韓国語に慣れていなくても誰でも簡単に使用できる直感的なインターフェースを提供</string>
