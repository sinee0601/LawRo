    <!-- App Info Screen -->
    <string name="app_intro_title">应用介绍</string>
    <string name="app_intro_subtitle">帮助外国劳动者理解合同和保护权益的AI合同分析应用</string>
    <string name="app_intro_description">在韩国工作的外国劳动者中，相当数量的人不签订合同，或者即使签订了也无法理解内容，因此遭受工资拖欠、不当解雇、长时间劳动等严重的权益侵害。\n\nLawRo是一款利用AI自动分析劳动合同的应用，帮助外国劳动者用母语理解自己的合同内容，识别违规行为，自主保护自己的权益。</string>
    <string name="main_features">主要功能</string>
    <string name="feature_contract_analysis">合同自动分析</string>
    <string name="feature_contract_analysis_desc">通过OCR识别劳动合同，检查必需项目遗漏情况和法律违规可能性</string>
    <string name="feature_multilingual_support">母语法律解释提供</string>
    <string name="feature_multilingual_support_desc">将合同内容翻译成用户母语，便于理解和说明</string>
    <string name="feature_contract_history">合同历史管理</string>
    <string name="feature_contract_history_desc">数字化保存签订的合同，可用于纠纷或合同续签</string>
    <string name="feature_chatbot_consultation">劳动/法律聊天机器人咨询</string>
    <string name="feature_chatbot_consultation_desc">实时咨询劳动条件、法律违规等疑问</string>
    <string name="feature_worktime_tracking">工作时间记录和工资计算</string>
    <string name="feature_worktime_tracking_desc">自动记录劳动时间，支持准确的工资计算，包括加班费</string>
    <string name="feature_multilingual_ui">多语言支持UI</string>
    <string name="feature_multilingual_ui_desc">即使不熟悉韩语，任何人都可以轻松使用的直观界面</string>
