    <!-- App Info Screen -->
    <string name="app_intro_title">App Introduction</string>
    <string name="app_intro_subtitle">AI Contract Analysis App for Foreign Workers\' Contract Understanding and Rights Protection</string>
    <string name="app_intro_description">Many foreign workers in Korea either do not create employment contracts or, even when they do, cannot understand the content, leading to serious rights violations such as unpaid wages, unfair dismissal, and long working hours.\n\nLawRo is an app that uses AI to automatically analyze employment contracts, helping foreign workers understand their contract content in their native language, recognize violations, and protect their rights on their own.</string>
    <string name="main_features">Main Features</string>
    <string name="feature_contract_analysis">Automatic Contract Analysis</string>
    <string name="feature_contract_analysis_desc">OCR recognition of employment contracts to check for missing essential items and potential legal violations</string>
    <string name="feature_multilingual_support">Native Language Legal Interpretation</string>
    <string name="feature_multilingual_support_desc">Translation and explanation of contract content in user\'s native language for easy understanding</string>
    <string name="feature_contract_history">Contract History Management</string>
    <string name="feature_contract_history_desc">Digital storage of concluded contracts, available for disputes or contract renewals</string>
    <string name="feature_chatbot_consultation">Labor/Legal Chatbot Consultation</string>
    <string name="feature_chatbot_consultation_desc">Real-time consultation for questions about working conditions and legal violations</string>
    <string name="feature_worktime_tracking">Work Time Tracking and Salary Calculation</string>
    <string name="feature_worktime_tracking_desc">Automatic recording of working hours and support for accurate salary calculations including overtime pay</string>
    <string name="feature_multilingual_ui">Multilingual UI Support</string>
    <string name="feature_multilingual_ui_desc">Intuitive interface that anyone can easily use, even if not familiar with Korean</string>
