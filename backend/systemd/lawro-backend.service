[Unit]
Description=LawRo Backend API
After=network.target

[Service]
Type=notify
User=ec2-user
WorkingDirectory=/home/ec2-user/LawRo/backend
Environment="PATH=/home/ec2-user/LawRo/backend/venv/bin"
EnvironmentFile=/home/ec2-user/LawRo/backend/.env

# Gunicorn + Uvicorn 실행
ExecStart=/home/ec2-user/LawRo/backend/venv/bin/gunicorn \
  --workers 4 \
  --worker-class uvicorn.workers.UvicornWorker \
  --bind 127.0.0.1:8000 \
  --timeout 120 \
  --access-logfile /var/log/lawro/access.log \
  --error-logfile /var/log/lawro/error.log \
  --log-level info \
  app.main:app

# 프로세스 관리
Restart=always
RestartSec=10
StandardOutput=append:/var/log/lawro/access.log
StandardError=append:/var/log/lawro/error.log

# 성능 설정
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
